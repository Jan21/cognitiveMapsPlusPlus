#!/bin/bash
#SBATCH -A EUHPC_B38_121
#SBATCH -p boost_usr_prod
#SBATCH --job-name=tune683q
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G
#SBATCH --time=04:00:00
#SBATCH --array=0-239%40
#SBATCH --output=/leonardo_scratch/large/userexternal/jhula000/cmpp_out/tune683q_%a.out
# COMPLETE BASELINE TUNING AT THE imgDiv BED: 683 maps AND --poolq 6800 (167k training pairs; the integ 0.953
# ran here, while the first tune683/tune683w screens mistakenly used poolq 2000 = 49k pairs and were cancelled;
# poolq is not printed in RESULT json, which hid the mismatch). Grids: slots and 1x1-pixels at encoder width
# {32,64}, 3x3 CNN at width {64,128}; pooling/depth/d/lr as in the phase-A space; objch on; seed 0; winners
# then get 3 seeds x both splits (and objch-off arm).
module purge; module load profile/deeplrn cineca-ai/4.3.0 >/dev/null 2>&1
export PYTHONPATH=$HOME/cmpp/torch-quasimetric:$PYTHONPATH
cd $HOME/cmpp/distance_model
