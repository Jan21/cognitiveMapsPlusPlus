#!/bin/bash
#SBATCH -A EUHPC_B38_121
#SBATCH -p boost_usr_prod
#SBATCH --job-name=tune683
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G
#SBATCH --time=04:00:00
#SBATCH --array=0-143%40
#SBATCH --output=/leonardo_scratch/large/userexternal/jhula000/cmpp_out/tune683_%a.out
# COMPLETE BASELINE TUNING SCREEN AT 683 MAPS (seed 0, map split, L5): the 200-map winners are not guaranteed
# optimal at higher map diversity (proven: iqe slots 0.836 vs its 200-map-best 3x3-flatten 0.767 at 683).
# Mirrors the phase-A search space (baselines.md 3a-3d) minus dead branches: fgpix (excluded by design),
# latentnorm (hurts), 3x3+mean-pool (never won), lr 5e-4 (never won). objch 1 everywhere (helped or neutral
# in the 200-map screen; objch-off only for the winners in the seeds wave). Winners then get 3 seeds x both splits.
module purge; module load profile/deeplrn cineca-ai/4.3.0 >/dev/null 2>&1
export PYTHONPATH=$HOME/cmpp/torch-quasimetric:$PYTHONPATH
cd $HOME/cmpp/distance_model
